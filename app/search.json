---
layout: null
---
[
{% assign subject_pages = site.pages
  | where_exp: 'item', 'item.subject != nil'
  | where_exp: 'item', 'item.subject != "home"'
-%}
{%- assign lessons = site.sql
  | concat: site.de
  | concat: site.ai
  | concat: site.ml
  | concat: site.infra
  | concat: subject_pages
  | sort: 'sequence'
-%}
{%- for lesson in lessons -%}
  {"title":{{ lesson.title | jsonify }},"subject":{{ lesson.subject | jsonify }},"chapter":
  {{- lesson.chapter | jsonify -}}
  ,"description":{{ lesson.description | default: '' | jsonify }},"keywords":
  {{- lesson.keywords | jsonify -}}
  ,"aliases":{{ lesson.aliases | jsonify }},"tools":
  {{- lesson.tools | jsonify -}}
  ,"interview_queries":
  {{- lesson.interview_queries | jsonify -}}
  ,"url":{{ lesson.url | relative_url | jsonify }},"content":
  {{-
    lesson.content
    | markdownify
    | replace: '<template', '<!--<template'
    | replace: '</template>', '</template>-->'
    | replace: '<select', '<!--<select'
    | replace: '</select>', '</select>-->'
    | replace: '</', ' </'
    | strip_html
    | normalize_whitespace
    | jsonify
  -}}
  }{% unless forloop.last %},{% endunless -%}
{%- endfor %}
]
