  "parquet-layout": {
    "title": "Inside a Parquet file: prune row groups, project columns",
    "kind": "parquet",
    "description": "A file contains row groups; each row group contains one chunk per column, and each column chunk contains pages. Footer statistics can rule out a row group, while column projection avoids reading unused chunks. A file, row group and page are different sizing units.",
    "author": "Apache Software Foundation",
    "source_url": "https://parquet.apache.org/docs/file-format/",
    "row_groups": [
      {
        "title": "Row group 1 · June 30",
        "decision": "Skip this group",
        "skipped": true,
        "statistics": "event_date min = max = 2026-06-30: no row can satisfy the filter.",
        "columns": [
          {
            "name": "event_date",
            "pages": ["Page 1: Jun 30", "Page 2: Jun 30"]
          },
          {
            "name": "device_id",
            "pages": ["Page 1: 41, 57", "Page 2: 63, 88"]
          },
          {
            "name": "kwh",
            "pages": ["Page 1: 2.1, 3.4", "Page 2: 1.8, 4.0"]
          }
        ]
      },
      {
        "title": "Row group 2 · July 1",
        "decision": "Read two column chunks",
        "statistics": "event_date min = max = 2026-07-01: read the projected columns; evaluate the predicate as required.",
        "columns": [
          {
            "name": "event_date",
            "read": true,
            "pages": ["Page 1: Jul 1", "Page 2: Jul 1"]
          },
          {
            "name": "device_id",
            "pages": ["Page 1: 41, 57", "Page 2: 63, 88"]
          },
          {
            "name": "kwh",
            "read": true,
            "pages": ["Page 1: 2.6, 3.1", "Page 2: 2.0, 4.3"]
          }
        ]
      }
    ]
  },
