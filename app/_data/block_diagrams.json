  "distributed-query-stages": {
    "title": "Follow the work through a distributed query",
    "description": "Two independent inputs feed the join. Workers first combine rows locally; exchange then groups partial results by region. Final aggregation merges the partials for each region. This is an illustrative physical plan; actual stages depend on the engine and query.",
    "author": "Google Cloud BigQuery query plan explanation",
    "source_url": "https://docs.cloud.google.com/bigquery/docs/query-plan-explanation",
    "panels": [
      {
        "columns": 2,
        "compact_columns": 2,
        "nodes": [
          {
            "id": "orders",
            "title": "Orders scan",
            "detail": "Prune dates and read required columns",
            "column": 1,
            "row": 1
          },
          {
            "id": "merchants",
            "title": "Merchant scan",
            "detail": "Filter the dimension and verify key uniqueness",
            "column": 2,
            "row": 1
          },
          {
            "id": "join",
            "title": "Join on merchant",
            "detail": "Inspect input, output and unmatched row counts",
            "column": 1,
            "row": 2,
            "span": 2
          },
          {
            "id": "partial",
            "title": "Local partial sums",
            "detail": "Each worker reduces its own rows",
            "column": 1,
            "row": 3,
            "span": 2,
            "items_columns": 3,
            "items": [
              {
                "title": "Worker A",
                "detail": "North 10 · South 4"
              },
              {
                "title": "Worker B",
                "detail": "North 5 · East 8"
              },
              {
                "title": "Worker C",
                "detail": "South 6 · East 2"
              }
            ]
          },
          {
            "id": "exchange",
            "title": "Exchange by region",
            "detail": "Move partials to the worker responsible for each key",
            "column": 1,
            "row": 4,
            "span": 2,
            "emphasis": true,
            "items_columns": 3,
            "items": [
              {
                "title": "North",
                "detail": "10 + 5"
              },
              {
                "title": "South",
                "detail": "4 + 6"
              },
              {
                "title": "East",
                "detail": "8 + 2"
              }
            ]
          },
          {
            "id": "final",
            "title": "Final aggregation",
            "detail": "North 15 · South 10 · East 10",
            "column": 1,
            "row": 5,
            "span": 2
          }
        ],
        "edges": [
          {
            "from": "orders",
            "to": "join"
          },
          {
            "from": "merchants",
            "to": "join"
          },
