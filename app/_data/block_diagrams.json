  "kappa": {
    "title": "Kappa: rebuild by replay while the active view serves",
    "description": "The current processor continues serving while a new version replays retained events. The candidate catches up and is reconciled with the active result. A controlled reader switch publishes the accepted candidate.",
    "author": "Microsoft",
    "source_url": "https://learn.microsoft.com/en-us/azure/architecture/databases/guide/big-data-architectures",
    "panels": [
      {
        "columns": 2,
        "compact_columns": 2,
        "nodes": [
          {
            "id": "log",
            "title": "Retained event log",
            "detail": "Replay enough history to rebuild the result",
            "column": 1,
            "row": 1,
            "span": 2
          },
          {
            "id": "current",
            "title": "Current processor",
            "detail": "Continues processing live events",
            "column": 1,
            "row": 2
          },
          {
            "id": "replay",
            "title": "Replay processor",
            "detail": "Runs the new processing logic",
            "column": 2,
            "row": 2
          },
          {
            "id": "active",
            "title": "Active view",
            "detail": "Readers continue using this result",
            "column": 1,
            "row": 3
          },
          {
            "id": "candidate",
            "title": "Candidate view",
            "detail": "Isolated rebuild; readers have not switched",
            "column": 2,
            "row": 3
          },
          {
            "id": "validate",
            "title": "Catch up and reconcile",
            "detail": "Check progress, counts and business aggregates",
            "column": 1,
            "row": 4,
            "span": 2,
            "emphasis": true
          },
          {
            "id": "publish",
            "title": "Switch the reader pointer",
            "detail": "Publish the candidate and retain a rollback path",
            "column": 1,
            "row": 5,
            "span": 2
          }
        ],
        "edges": [
          {
            "from": "log",
            "to": "current"
          },
          {
            "from": "log",
            "to": "replay"
          },
          {
            "from": "current",
            "to": "active"
          },
          {
            "from": "replay",
            "to": "candidate"
          },
          {
            "from": "active",
            "to": "validate",
            "control": true
          },
          {
            "from": "candidate",
            "to": "validate"
          },
          {
            "from": "validate",
            "to": "publish"
          }
        ]
      }
    ]
  },
